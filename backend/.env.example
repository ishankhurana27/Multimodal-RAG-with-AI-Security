# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOW_ORIGIN=http://localhost:5173;http://localhost:8080

# ── Admin account (created on first run) ──────────────────────────────────────
WEBUI_ADMIN_EMAIL=admin@yourdomain.com
WEBUI_ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
WEBUI_ADMIN_NAME=Admin

# ── Vector DB ─────────────────────────────────────────────────────────────────
# Options: weaviate | qdrant | chroma | milvus
VECTOR_DB=weaviate

# ── Weaviate (local Docker) ───────────────────────────────────────────────────
WEAVIATE_HTTP_HOST=localhost
WEAVIATE_GRPC_HOST=localhost
WEAVIATE_HTTP_PORT=8085
WEAVIATE_GRPC_PORT=50051
WEAVIATE_HTTP_SECURE=false
WEAVIATE_GRPC_SECURE=false
WEAVIATE_API_KEY=

# ── Weaviate Cloud (if using Weaviate Cloud Service) ─────────────────────────
# WEAVIATE_HTTP_HOST=YOUR_CLUSTER.c0.region.gcp.weaviate.cloud
# WEAVIATE_GRPC_HOST=grpc-YOUR_CLUSTER.c0.region.gcp.weaviate.cloud
# WEAVIATE_HTTP_PORT=443
# WEAVIATE_GRPC_PORT=443
# WEAVIATE_HTTP_SECURE=true
# WEAVIATE_GRPC_SECURE=true
# WEAVIATE_API_KEY=YOUR_WEAVIATE_API_KEY

# ── MySQL (local — replaces SQLite) ──────────────────────────────────────────
# Option A: full URL (recommended)
DATABASE_URL=mysql+pymysql://futureverseai:YOUR_DB_PASSWORD@localhost:3306/futureverseai?charset=utf8mb4
# Option B: individual components (alternative to DATABASE_URL)
# DATABASE_TYPE=mysql+pymysql
# DATABASE_USER=futureverseai
# DATABASE_PASSWORD=YOUR_DB_PASSWORD
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_NAME=futureverseai
DATABASE_POOL_SIZE=10
DATABASE_POOL_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD
NEO4J_DATABASE=neo4j

# ── Python / Logging ──────────────────────────────────────────────────────────
PYTHONPATH=YOUR_PROJECT_ROOT\FutureverseAI
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
GLOBAL_LOG_LEVEL=INFO
