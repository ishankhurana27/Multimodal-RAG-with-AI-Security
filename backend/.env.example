# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOW_ORIGIN=http://localhost:5173;http://localhost:8080

# ── Admin account (created on first run) ──────────────────────────────────────
WEBUI_ADMIN_EMAIL=admin@yourdomain.com
WEBUI_ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
WEBUI_ADMIN_NAME=Admin

# ── Vector DB ─────────────────────────────────────────────────────────────────
# Options: weaviate | qdrant | chroma | milvus
VECTOR_DB=weaviate

# ── Weaviate (local Docker) ───────────────────────────────────────────────────
WEAVIATE_HTTP_HOST=localhost
WEAVIATE_GRPC_HOST=localhost
WEAVIATE_HTTP_PORT=8085
WEAVIATE_GRPC_PORT=50051
WEAVIATE_HTTP_SECURE=false
WEAVIATE_GRPC_SECURE=false
WEAVIATE_API_KEY=

# ── Weaviate Cloud (if using Weaviate Cloud Service) ─────────────────────────
# WEAVIATE_HTTP_HOST=YOUR_CLUSTER.c0.region.gcp.weaviate.cloud
# WEAVIATE_GRPC_HOST=grpc-YOUR_CLUSTER.c0.region.gcp.weaviate.cloud
# WEAVIATE_HTTP_PORT=443
# WEAVIATE_GRPC_PORT=443
# WEAVIATE_HTTP_SECURE=true
# WEAVIATE_GRPC_SECURE=true
# WEAVIATE_API_KEY=YOUR_WEAVIATE_API_KEY

# ── MySQL (local — replaces SQLite) ──────────────────────────────────────────
# Option A: full URL (recommended)
DATABASE_URL=mysql+pymysql://futureverseai:YOUR_DB_PASSWORD@localhost:3306/futureverseai?charset=utf8mb4
# Option B: individual components (alternative to DATABASE_URL)
# DATABASE_TYPE=mysql+pymysql
# DATABASE_USER=futureverseai
# DATABASE_PASSWORD=YOUR_DB_PASSWORD
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_NAME=futureverseai
DATABASE_POOL_SIZE=10
DATABASE_POOL_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD
NEO4J_DATABASE=neo4j

# ── Python / Logging ──────────────────────────────────────────────────────────
# PYTHONPATH is NOT required: launch with `uvicorn futureverse_ai.main:app`
# from the backend/ directory (start.sh does this) and the package resolves
# via cwd. Only set this if you launch from elsewhere (point it at backend/).
PYTHONPATH=
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
GLOBAL_LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────────────
# ADD THESE to backend/.env.example — the pipeline reads them but they are
# currently undocumented, so operators don't know to set them. Values shown are
# the code defaults; the ones marked ★ enable features that are OFF by default.
# ─────────────────────────────────────────────────────────────────────────────

# --- Retrieval feature flags (Phase 3: these are OFF unless set!) ---
ENABLE_NEO4J=true                         # ★ turn on knowledge-graph retrieval
ENABLE_RAG_HYBRID_SEARCH=true             # ★ BM25 + vector ensemble (your best path)
ENABLE_RAG_HYBRID_SEARCH_ENRICHED_TEXTS=true
RAG_RERANKING_MODEL=BAAI/bge-reranker-v2-m3   # ★ empty = no reranking
RAG_TOP_K=6                               # retrieve-wide; was 3
RAG_TOP_K_RERANKER=20                     # rerank pool; was 3
RAG_RELEVANCE_THRESHOLD=0.3
RAG_HYBRID_BM25_WEIGHT=0.5

# --- Embedding (keep ingest == query model; Phase 1 H-6 / Phase 2 §5) ---
RAG_EMBEDDING_ENGINE=                     # ""=sentence_transformers | ollama | openai | azure_openai
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_BATCH_SIZE=8
ENABLE_ASYNC_EMBEDDING=true
EMBED_MODEL=nomic-embed-text              # used by graph pipeline path

# --- Chunking (Phase 3 §1) ---
CHUNKING_STRATEGY=hierarchical            # hierarchical | character | token
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
RAG_TEXT_SPLITTER=                        # ""=character | token

# --- Ollama / local models (KG + contextual chunking + answer) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_PARALLEL=3                     # match contextual-chunking workers
KG_EXTRACT_MODEL=llama3.1:8b
CONTEXTUAL_CHUNKING_MODEL=qwen2.5:7b
RAG_ANSWER_MODEL=qwen2.5:32b
ATLAS_WORK_DIR=                           # KG extraction scratch dir (default: backend/data/atlas_work)

# --- Observability ---
GLOBAL_LOG_LEVEL=INFO
ENABLE_OTEL=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# --- Added in audit (Phase 3 continue) ---
RAG_STRICT_GROUNDING=false        # true = closed-book; never answer outside the context
ENABLE_RAG_EMBEDDING_CACHE=false  # true = cross-request query-embedding cache (Redis)
RAG_EMBEDDING_CACHE_TTL=86400     # seconds
REDIS_URL=redis://localhost:6379/0

# --- Retrieval debug log (file-part fix) ---
RAG_DEBUG_LOG=false               # true = write per-query debug log
RAG_DEBUG_LOG_DIR=                # dir for the debug log (default ./logs)

# --- KG ingestion timing (polls Weaviate count, not a fixed sleep) ---
NEO4J_INGEST_EMBED_WAIT=120      # max seconds to wait for embedding before KG read
NEO4J_INGEST_POLL_INTERVAL=3     # seconds between count polls
